{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "main/Dockerfile"
  },
  "deploy": {
    "startCommand": "node --disable-warning=ExperimentalWarning --max-old-space-size=700 main/src/server.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
