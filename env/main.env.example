# ===== V_N main server (Render: Docker, Free, 0.5 CPU / 512 MB) =====
PUBLIC_URL=https://vn-main.onrender.com
# Blomp (OpenStack Swift). Контейнер = твоя почта Blomp.
BLOMP_USER=you@example.com
BLOMP_PASS=change-me
# Общие секреты — сгенерируй длинные случайные строки (openssl rand -hex 32)
SWARM_SECRET=change-me-swarm-secret-64-chars
BOT_SECRET=change-me-bot-secret
ENCODER_TOKEN=change-me-encoder-token
# Бот
BOT_URL=https://vn-bot.onrender.com
BOT_USERNAME=your_bot_username_without_at
# Telegram ID админов (узнать: @userinfobot), через запятую
ADMIN_TG_IDS=123456789
# как часто сохранять БД в Blomp (сек)
BACKUP_EVERY_SEC=120
