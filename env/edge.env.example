# ===== V_N swarm edge (один и тот же образ на 14–50 аккаунтах Render) =====
MAIN_URL=https://vn-main.onrender.com
SWARM_SECRET=change-me-swarm-secret-64-chars
# oregon | ohio | virginia | frankfurt | singapore — тот регион, где создан сервис на Render
EDGE_REGION=frankfurt
# необязательно: NODE_ID=edge-fra-07 (по умолчанию берётся из адреса *.onrender.com)
# RAM-кэш сегментов, МБ (главный может переопределить из панели)
EDGE_CACHE_MB=160
