# ===== V_N encoder (твой ПК / VPS / GitHub Actions) =====
MAIN_URL=https://vn-main.onrender.com
ENCODER_TOKEN=change-me-encoder-token
ENCODER_NAME=home-pc
# av1 | av1compat | h264 | lite  (профиль по умолчанию задаётся в панели)
# SVT-AV1 пресет: 4 (медленно, лучше) … 10 (быстро). 8 — баланс
ENC_SVT_PRESET=8
ENC_X264_PRESET=medium
# none | nvenc (видеокарта NVIDIA: av1_nvenc / h264_nvenc)
ENC_HW=none
ENC_UPLOADS=6
